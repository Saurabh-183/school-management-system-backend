          "raw": "{\n  \"email\": \"saurabh.agnihotri@example.com\",\n  \"password\": \"Password@123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "login"]
        },
        "description": "Authenticate user, returns JWT accessToken and user object with role."

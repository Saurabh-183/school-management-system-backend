    {
      "name": "API 1 - Create User",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "const json = pm.response.json();",
              "if (json.success && json.data) {",
              "    pm.collectionVariables.set('userId', json.data._id);",
              "}"

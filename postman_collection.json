    {
      "name": "API 2 - Create Session",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "const json = pm.response.json();",
              "if (json.success && json.data) {",
              "    pm.collectionVariables.set('sessionId', json.data._id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"teacherId\": \"{{teacherId}}\",\n  \"startTime\": \"2026-11-20T10:00:00.000Z\",\n  \"endTime\": \"2026-11-20T11:00:00.000Z\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/sessions",
          "host": ["{{baseUrl}}"],
          "path": ["sessions"]
        },
        "description": "Create a new session for a teacher. Default status is AVAILABLE. Validates teacher exists and endTime > startTime."
      },
      "response": []
    },
    {
      "name": "API 3 - Available Sessions for Booking (Aggregation)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/sessions/available?dateTimestamp={{dateTimestamp}}&page=1&limit=10",
          "host": ["{{baseUrl}}"],
          "path": ["sessions", "available"],
          "query": [
            {
              "key": "dateTimestamp",
              "value": "{{dateTimestamp}}",
              "description": "Timestamp (ms/seconds) or ISO date for target day"
            },
            {
              "key": "page",
              "value": "1",
              "description": "Page number (1-indexed)"
            },
            {
              "key": "limit",
              "value": "10",
              "description": "Items per page"
            },
            {
              "key": "search",
              "value": "Abhishek",
              "disabled": true,
              "description": "Optional search by teacher name or subject"
            }
          ]
        },
        "description": "Mandatory MongoDB Aggregation Pipeline: returns AVAILABLE sessions matching the target date with populated teacher details."
      },
      "response": []
    },
    {
      "name": "API 4 - Book Session",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"{{userId}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/sessions/{{sessionId}}/book",
          "host": ["{{baseUrl}}"],
          "path": ["sessions", "{{sessionId}}", "book"]
        },
        "description": "Books an AVAILABLE session. Atomic update changes status to BOOKED and associates userId."
      },
      "response": []
    },
    {
      "name": "API 5 - Mark Session Complete",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/sessions/{{sessionId}}/complete",
          "host": ["{{baseUrl}}"],
          "path": ["sessions", "{{sessionId}}", "complete"]
        },
        "description": "Marks a BOOKED session as COMPLETED and sets the completedAt timestamp."
      },
      "response": []
    },
    {
      "name": "API 6 - User Session List (Aggregation $facet)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/users/{{userId}}/sessions",
          "host": ["{{baseUrl}}"],
          "path": ["users", "{{userId}}", "sessions"]
        },
        "description": "Mandatory MongoDB Aggregation Pipeline: returns sessions for user separated into upcomingSessions and completedSessions using $facet."
      },
      "response": []
    }

{
  "name": "teacher-booking-backend",
  "version": "1.0.0",
  "description": "Teacher Booking Platform REST API built with Node.js, Express, TypeScript, and MongoDB",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "rimraf dist && tsc",
    "start": "node dist/server.js",
    "seed": "tsx src/scripts/seed.ts",
    "test:api": "tsx src/scripts/test-api.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "nodejs",
    "typescript",
    "express",
    "mongodb",
    "mongoose"
  ],
  "author": "Backend Developer",
  "license": "MIT",
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.10.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.8.4",
    "morgan": "^1.10.0",
    "nodemailer": "^10.6.1",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.19.2"
  }
}
